# ==========================================
# Clima Social · Panel de Supervisión de Campo
# Copia este archivo como .env y completa los
# valores reales. NUNCA subas .env al repositorio.
# ==========================================

# Puerto del servidor
PORT=3001

# ID público del asset (formulario) en KoboToolbox
ASSET_ID_PICHINCHA=

# Token de API de KoboToolbox
API_TOKEN=

# Nombre del proyecto que se muestra en el encabezado
NOMBRE_PROYECTO=Encuesta Quito PM - Septiembre - 2026

# Campos de KoBO para encuestador y supervisor
CAMPO_ENCUESTADOR=encuestador
CAMPO_SUPERVISOR=supervisor

# Meta de encuestas totales
META_ENCUESTAS=2000

# Tiempo de caché del proxy de Kobo (segundos)
CACHE_TTL_SEGUNDOS=90

# Coordenadas y zoom inicial del mapa (Opcional)
# Si no se definen, el mapa calcula automáticamente el centro y encuadre óptimo según el GeoJSON cargado
# Pichincha / Quito: LNG=-78.4678, LAT=-0.1807
# Machala: LNG=-79.9554, LAT=-3.2581
MAPA_CENTRO_LNG=-78.4678
MAPA_CENTRO_LAT=-0.1807
MAPA_ZOOM_INICIAL=11
