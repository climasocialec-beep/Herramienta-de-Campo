# ==========================================
# Clima Social · Panel de Supervisión de Campo
# Copia este archivo como .env y completa los
# valores reales. NUNCA subas .env al repositorio.
# ==========================================

# Puerto del servidor
PORT=3001

# ID público del asset (formulario) en KoboToolbox
ASSET_ID=

# Token de API de KoboToolbox
API_TOKEN=

# Nombre del proyecto que se muestra en el encabezado
NOMBRE_PROYECTO=Supervisión de Campo

# Campos de KoBO para encuestador y supervisor
CAMPO_ENCUESTADOR=C_digo_encuestador
CAMPO_SUPERVISOR=C_digo_Supervisor

# Meta de encuestas totales
META_ENCUESTAS=1600

# Tiempo de caché del proxy de Kobo (segundos)
CACHE_TTL_SEGUNDOS=90
